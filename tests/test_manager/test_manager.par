### Generic
run_on_hpc_local		True			# True -> HPC; False: Local multithreading

### HPC
requested_nodes		2			# Number of nodes to be requested on HPC
cpus_per_node		10			# CPU cores per node (not counting hyperthreading). If variable, choose minimum value
partition		multinode		# Partition on HPC
hpc_exec_dir        ~/locusts_try			# HPC path where the jobs will be executed and the temp files stored
#local_shared_dir				# Do the HPC service and the local machine share a directory? If so, you can specify a shared folder to use
scheduler   oar
#data_transfer_protocol	tests/test_manager/data_transfer_protocol.sh
#transfer_archive	True			# Send the filesystem to the remote as one tar.gz archive instead of single files
#staggered		True			# Stagger the start times of the tasks launched together on the same node
#stagger_time		300			# Seconds between two staggered task starts
#diskspace_required	50G			# Before running, check there is at least this free space where hpc_exec_dir is
#checkquota_command	checkquota		# Command reporting "<mount>: <used> <quota>" lines (falls back on df)

### Local multithreading
number_of_processors	4			# Number of processors to use on the local machine

### Singularity
singularity		singularity
singularity_container	~/giacomofiorin_default_encompass-development.sif
singularity_modload	module load singularity
